# 百嘉瑞BI V15.7.6
# Windows 本地：复制为项目根目录 .env
# 飞牛宝塔生产：保存为 /www/wwwroot/baijiarui-bi/shared/.env
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=baijiarui_bi
MYSQL_USER=baijiarui
MYSQL_PASSWORD=change_me
DATABASE_URL=
APP_SECRET=dev-secret
APP_ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_NAME=bjr_session
SESSION_HOURS=12
REMEMBER_SESSION_DAYS=7
SESSION_COOKIE_SECURE=false
TRUSTED_PROXY_IPS=
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900
MAX_UPLOAD_BYTES=52428800
MAX_IMPORT_ROWS=200000
MAX_IMPORT_WORKSHEETS=20
MAX_XLSX_UNCOMPRESSED_BYTES=524288000
MAX_EXPORT_ROWS=200000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# 正式生产示例（必须配合 HTTPS）：
# APP_ENVIRONMENT=production
# SESSION_COOKIE_SECURE=true
# CORS_ORIGINS=https://bi.example.com
# TRUSTED_PROXY_IPS=127.0.0.1,::1
